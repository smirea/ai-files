      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "id": "settle-worktree",
      "name": "Settle worktree",
      "command": "\"$HOME/bin/agent-t3-worktree\" settle",
      "icon": "configure",
      "runOnWorktreeCreate": false,
      "runOnSettle": true,
      "async": false
